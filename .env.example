# 이 파일을 직접 고치지 말고 아래 명령으로 .env.local 을 만드세요.
#   npm run set-password
#
# 로컬 개발용 기본 비밀번호: portfolio-dev
# (처음 설정된 값입니다. 배포 전에 반드시 npm run set-password 로 바꾸세요.)

# 관리자 비밀번호의 암호화된 값 (원문 비밀번호가 아님)
ADMIN_PASSWORD_HASH=

# 로그인 표식(쿠키) 서명에 쓰는 임의의 긴 문자열
SESSION_SECRET=

# 배포 후 사이트 주소 (링크 미리보기·검색엔진용). 예: https://example.vercel.app
SITE_URL=http://localhost:3000
